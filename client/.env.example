# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API URL (for translation and other backend services)
VITE_BACKEND_URL=http://localhost:3001

# Google Cloud Translation API (Optional)
VITE_GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here

# Gemini AI Configuration
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Cloudflare R2 Configuration (for video storage)
VITE_CLOUDFLARE_ACCOUNT_ID=your-account-id-here
VITE_CLOUDFLARE_ACCESS_KEY_ID=your-access-key-id-here
VITE_CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-access-key-here
VITE_CLOUDFLARE_BUCKET_NAME=your-bucket-name-here

# Optional: Default language for translations
VITE_DEFAULT_LANGUAGE=en
